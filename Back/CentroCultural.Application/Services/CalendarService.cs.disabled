                .Include(e => e.RelatedCourse)
                .Include(e => e.RelatedBlogPost)
                .Where(e => e.IsActive && e.RelatedCourseId == courseId)
                .OrderBy(e => e.StartDateTime)
                .Select(e => MapToEventSummaryDto(e))
                .ToListAsync();
        }

        public async Task<IEnumerable<EventSummaryDto>> GetEventsByBlogPostAsync(Guid blogPostId)
        {
            return await _context.Events
                .Include(e => e.Organizer)
                .Include(e => e.RelatedCourse)
                .Include(e => e.RelatedBlogPost)
                .Where(e => e.IsActive && e.RelatedBlogPostId == blogPostId)
                .OrderBy(e => e.StartDateTime)
                .Select(e => MapToEventSummaryDto(e))
                .ToListAsync();
        }

