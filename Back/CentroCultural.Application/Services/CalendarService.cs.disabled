        public async Task<bool> SetEventFeaturedAsync(Guid eventId, bool isFeatured, int userId)
        {
            var eventEntity = await _context.Events.FirstOrDefaultAsync(e => e.Id == eventId);
            if (eventEntity == null) return false;

            var user = await _context.Usuario.FirstOrDefaultAsync(u => u.IdUsuario == userId);
            if (user?.RoleString != "administrador") return false;

            eventEntity.IsFeatured = isFeatured;
            await _context.SaveChangesAsync();
            return true;
        }

        private static string GetEventTypeColor(string eventType)
        {
            return eventType.ToLower() switch
            {
                "clase" => "#3B82F6",
                "taller" => "#10B981",
                "conferencia" => "#8B5CF6",
                "evento" => "#F59E0B",
                _ => "#6B7280"
            };
        }

        private static string GetEventTypeIcon(string eventType)
        {
            return eventType.ToLower() switch
            {
                "clase" => "academic-cap",
                "taller" => "wrench-screwdriver",
                "conferencia" => "microphone",
                "evento" => "calendar-days",
                _ => "calendar"
            };
        }
